# Copy to .env and fill values. Do not commit .env.
# Use the same username/password you use to login to PostgreSQL.

# Database (replace with your real PostgreSQL user, password, and database name)
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/dbname

# Auth (use a long random string in production)
SECRET_KEY=your-super-secret-key-min-32-chars

# Optional
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
